cmake_minimum_required(VERSION 3.21)

# cmake -DQT_ROOT=/path/to/Qt/kit -P scripts/deploy.cmake
get_filename_component(source_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT CMAKE_HOST_SYSTEM_NAME MATCHES "^(Linux|Windows)$")
    message(FATAL_ERROR "This packaging script supports Linux and Windows native builds.")
endif()
if(NOT DEFINED QT_ROOT)
    set(QT_ROOT "$ENV{QT_ROOT_DIR}")
endif()
if(NOT EXISTS "${QT_ROOT}/lib/cmake/Qt6/Qt6Config.cmake")
    message(FATAL_ERROR "Set -DQT_ROOT=/path/to/Qt/kit or QT_ROOT_DIR to a Qt 6.8+ kit matching your compiler.")
endif()
get_filename_component(QT_ROOT "${QT_ROOT}" ABSOLUTE)
if(NOT DEFINED BUILD_DIR)
    set(BUILD_DIR "${source_dir}/build/deploy-release")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
if(NOT DEFINED OUTPUT_DIR)
    string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
    set(OUTPUT_DIR "${source_dir}/dist/ZegaryApp-${CMAKE_HOST_SYSTEM_NAME}-${stamp}")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
if(EXISTS "${OUTPUT_DIR}" OR EXISTS "${OUTPUT_DIR}.zip")
    message(FATAL_ERROR "Output already exists. Choose a new -DOUTPUT_DIR=... to preserve its config and files.")
endif()
if(NOT DEFINED CONFIG_FILE)
    set(CONFIG_FILE "${source_dir}/Zegary/config/config.json")
endif()
get_filename_component(CONFIG_FILE "${CONFIG_FILE}" ABSOLUTE)
if(NOT EXISTS "${CONFIG_FILE}")
    message(FATAL_ERROR "Config file not found: ${CONFIG_FILE}")
endif()
file(READ "${CONFIG_FILE}" config_json)
string(JSON config_type ERROR_VARIABLE json_error TYPE "${config_json}")
if(json_error OR NOT config_type STREQUAL "OBJECT")
    message(FATAL_ERROR "CONFIG_FILE must contain a JSON object: ${CONFIG_FILE}")
endif()
if(NOT DEFINED JOBS)
    set(JOBS 4)
endif()
if(NOT JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "JOBS must be a positive integer.")
endif()
if(CMAKE_HOST_WIN32)
    set(ENV{PATH} "${QT_ROOT}/bin;$ENV{PATH}")
else()
    set(ENV{PATH} "${QT_ROOT}/bin:$ENV{PATH}")
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Deployment stopped (${result}). No completed package was produced.")
    endif()
endfunction()
run("${CMAKE_COMMAND}" -S "${source_dir}" -B "${BUILD_DIR}" -G Ninja
    "-DCMAKE_PREFIX_PATH=${QT_ROOT}" -DCMAKE_BUILD_TYPE=Release
    -DZEGARY_DEPLOY=ON -DCMAKE_INSTALL_BINDIR=bin -DCMAKE_INSTALL_LIBDIR=lib)
run("${CMAKE_COMMAND}" --build "${BUILD_DIR}" --config Release --parallel "${JOBS}")
run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config Release --prefix "${OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/bin/config")
configure_file("${CONFIG_FILE}" "${OUTPUT_DIR}/bin/config/config.json" COPYONLY)
configure_file("${source_dir}/README.md" "${OUTPUT_DIR}/README.md" COPYONLY)
if(CMAKE_HOST_WIN32)
    file(WRITE "${OUTPUT_DIR}/Start Dashboard.cmd" "@echo off\r\ncd /d \"%~dp0\"\r\nstart \"\" \"%~dp0bin\\ZegaryApp.exe\"\r\n")
else()
    file(WRITE "${OUTPUT_DIR}/start-dashboard.sh" "#!/bin/sh\napp_dir=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd) || exit 1\nexport LD_LIBRARY_PATH=\"$app_dir/lib\${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\nexec \"$app_dir/bin/ZegaryApp\" \"$@\"\n")
    file(CHMOD "${OUTPUT_DIR}/start-dashboard.sh" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
get_filename_component(output_parent "${OUTPUT_DIR}" DIRECTORY)
get_filename_component(output_name "${OUTPUT_DIR}" NAME)
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUTPUT_DIR}.zip" --format=zip "${output_name}"
    WORKING_DIRECTORY "${output_parent}" RESULT_VARIABLE archive_result)
if(NOT archive_result STREQUAL "0")
    message(FATAL_ERROR "The folder was deployed, but ZIP creation failed: ${archive_result}")
endif()
message(STATUS "Deployment folder: ${OUTPUT_DIR}")
message(STATUS "Share this archive: ${OUTPUT_DIR}.zip")
